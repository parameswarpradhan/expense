<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body class="bg-black p-10">
    <div class=" m-auto text-white border-2" >
        <h1 class="text-center text-xl">Register</h1>
    </div>
    <div class=" m-auto mt-40 text-white w-1/2 border-2 p-4 border-cyan-900">
        <form class="flex flex-col mb-4"action="/registerUser" method="post">
        <div class="flex justify-between"><h3>Enter User name</h3><input class="border-2 mb-4 border-blue-700"type="text" placeholder="username" name="username"></div>
        <div class="flex justify-between"><h3>Enter your Email</h3><input class="border-2 mb-4 border-blue-700"type="email" placeholder="Email" name="email"></div>
        <div class="flex justify-between"><h3>Enter Password</h3><input class="border-2 mb-4 border-blue-700"type="password" placeholder="password" name="password"></div>
        <div class="flex justify-between"><h3>Enter your Previous balance</h3><input class="border-2 mb-4 border-blue-700"type="number" placeholder="Balance" name="balance"></div>
        <div class="flex justify-center "><input class="bg-blue-700 w-50 text-center"type="submit" placeholder="submit"></div>
        </form>
    </div>
</body>
</html>