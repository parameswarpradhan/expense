<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <h1 class="text-xl text-center m-10 mt-5">details of all users</h1>
    <div class="flex flex-col justify-center items-center h-full">
    <div class="flex flex-col justify-center items-center bg-blue-200 w-3/4 p-5">
    <% for (let i = 0; i < users.length; i++) { %>
    <div class="bg-blue-300 p-3 w-1/2">
    <h2 class="text-white"> Name : <%= users[i].username %></h2>
    <h3 class="text-blue-700">Due is  :<span class="text-red-600"> <%= users[i].balance %></span></h3>
    </div>
    <br>
    <% } %>
    </div>
    </div>
    <h1 class="text-xl text-center  m-5">Want to create one new entry </h1>
    <div class="p-3 flex justify-center w-full "><a class="bg-blue-900 w-25 h-8 text-center rounded-sm text-white" href="/createEntry">create</a></div>
</body>
</html>