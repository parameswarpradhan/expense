<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>    
    <title>Document</title>
</head>
<body>
        <h1 class="text-xl text-center m-10 mt-5">Please fillup the Entry form.</h1>
        <form  action="/entry" method="post">
            <div class="flex justify-center items-center">
                <div class=" flex flex-col  justify-center bg-blue-200 p-5">
                <p class="text-center mb-3 bg-black text-white">Who have contributed</p>
                <% for (let i = 0; i < users.length; i++) { %>
                <div>
                <input type="radio" name="given" value="<%= users[i].username %>" id="<%= users[i].username %>">
                <label for="<%= users[i].username %>"><%= users[i].username %></label>
                </div>
                <% } %>
                <label  class="mt-5"for="amount">Enter amount contributed</label>
                <input class="bg-white" type="number" id="amount" name="amount" required>
                <div class="bg-blue-700 h-1 w-full mt-5"></div>
                <p class="text-center mt-10 mb-5 bg-black text-white">will be divided between</p>
                <% for (let i = 0; i < users.length; i++) { %>
            <div>
            <input type="checkbox" name="divided" value="<%= users[i].username %>" id="<%= users[i].username %>">
            <label for="<%= users[i].username %>"><%= users[i].username %></label>
            </div>
            <% } %>
                <div class="flex justify-center items-center">
                <input class="bg-blue-400 w-20 text-center mt-5"type="submit" value="submit">
                </div>
                </div>
            </form>
        </div>
        
    

</body>
</html>